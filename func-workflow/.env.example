# Azure Storage (for Durable Functions state)
AzureWebJobsStorage=UseDevelopmentStorage=true

# Azure Functions Runtime
FUNCTIONS_WORKER_RUNTIME=node

# Azure OpenAI Configuration
# Base URL should be the full path to your deployment:
# Format: https://{resource-name}.openai.azure.com/openai/deployments/{deployment-name}
# Example: https://my-openai.openai.azure.com/openai/deployments/gpt-4o
AOAI_BASE_URL=https://your-aoai-instance.openai.azure.com/openai/deployments/gpt-4
AOAI_API_KEY=your-api-key-here
AOAI_API_VERSION=2024-08-01-preview

# Mock Tools API
MOCK_TOOLS_BASE_URL=http://localhost:3001
